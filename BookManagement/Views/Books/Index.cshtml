@model IEnumerable<BookManagement.Models.Book>

@{
    ViewData["Title"] = "Quản lý sách";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="fw-bold">
            QUẢN LÝ SÁCH
        </h1>

        <a asp-action="Create"
           class="btn btn-primary">
            + Thêm sách
        </a>

    </div>

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th>ID</th>

                <th>Tên sách</th>

                <th>Tác giả</th>

                <th>Nhà xuất bản</th>

                <th>Giá</th>

                <th>Ngày xuất bản</th>

                <th>Hình ảnh</th>

                <th>Chức năng</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <!-- ID -->
                    <td>
                        @item.Id
                    </td>

                    <!-- Tên sách -->
                    <td>
                        @item.Title
                    </td>

                    <!-- Tác giả -->
                    <td>
                        @item.Author
                    </td>

                    <!-- Nhà xuất bản -->
                    <td>
                        @item.Publisher
                    </td>

                    <!-- Giá -->
                    <td>
                        @item.Price.ToString("N0") VNĐ
                    </td>

                    <!-- Ngày xuất bản -->
                    <td>
                        @item.PublishedDate.ToString("dd/MM/yyyy")
                    </td>

                    <!-- Hình ảnh -->
                    <td>

                        @if (!string.IsNullOrEmpty(item.ImageFileName))
                        {
                            <img src="~/images/books/@item.ImageFileName"
                                 alt="@item.Title"
                                 style="width:70px;
                            height:90px;
                            object-fit:cover;
                            border-radius:5px;" />
                        }
                        else
                        {
                            <span class="text-muted">
                                Chưa có ảnh
                            </span>
                        }

                    </td>

                    <!-- Chức năng -->
                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info">
                            Chi tiết
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning">
                            Sửa
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger">
                            Xóa
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
