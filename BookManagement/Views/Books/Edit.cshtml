@model BookManagement.Models.Book

@{
    ViewData["Title"] = "Sửa sách";
}

<div class="container mt-4">

    <h1 class="fw-bold">
        SỬA SÁCH
    </h1>

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <!-- Tên sách -->
        <div class="mb-3">

            <label asp-for="Title"
                   class="form-label">
            </label>

            <input asp-for="Title"
                   class="form-control" />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>

        </div>

        <!-- Tác giả -->
        <div class="mb-3">

            <label asp-for="Author"
                   class="form-label">
            </label>

            <input asp-for="Author"
                   class="form-control" />

            <span asp-validation-for="Author"
                  class="text-danger">
            </span>

        </div>

        <!-- Nhà xuất bản -->
        <div class="mb-3">

            <label asp-for="Publisher"
                   class="form-label">
            </label>

            <input asp-for="Publisher"
                   class="form-control" />

        </div>

        <!-- Giá -->
        <div class="mb-3">

            <label asp-for="Price"
                   class="form-label">
            </label>

            <input asp-for="Price"
                   type="number"
                   class="form-control" />

            <span asp-validation-for="Price"
                  class="text-danger">
            </span>

        </div>

        <!-- Ngày xuất bản -->
        <div class="mb-3">

            <label asp-for="PublishedDate"
                   class="form-label">
            </label>

            <input asp-for="PublishedDate"
                   type="date"
                   class="form-control" />

        </div>

        <!-- Ảnh hiện tại -->
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <div class="mb-3">

                <label class="form-label">
                    Ảnh hiện tại
                </label>

                <br />

                <img src="~/images/books/@Model.ImageFileName"
                     alt="Ảnh sách"
                     style="width:150px;
                height:200px;
                object-fit:cover;
                border-radius:8px;" />

            </div>
        }

        <!-- Chọn ảnh mới -->
        <div class="mb-3">

            <label class="form-label">
                Chọn ảnh mới
            </label>

            <input type="file"
                   name="ImageFile"
                   class="form-control"
                   accept="image/*" />

            <small class="text-muted">
                Nếu không chọn ảnh mới thì ảnh hiện tại
                sẽ được giữ nguyên.
            </small>

        </div>

        <!-- Nút -->
        <button type="submit"
                class="btn btn-warning">
            Lưu thay đổi
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>

    </form>

</div>