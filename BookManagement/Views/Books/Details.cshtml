@model BookManagement.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách";
}

<div class="container mt-4">

    <h1 class="fw-bold">
        CHI TIẾT SÁCH
    </h1>

    <hr />

    <dl class="row">

        <!-- Tên sách -->
        <dt class="col-sm-3">
            Tên sách
        </dt>

        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <!-- Tác giả -->
        <dt class="col-sm-3">
            Tác giả
        </dt>

        <dd class="col-sm-9">
            @Model.Author
        </dd>

        <!-- Nhà xuất bản -->
        <dt class="col-sm-3">
            Nhà xuất bản
        </dt>

        <dd class="col-sm-9">
            @Model.Publisher
        </dd>

        <!-- Giá -->
        <dt class="col-sm-3">
            Giá
        </dt>

        <dd class="col-sm-9">
            @Model.Price.ToString("N0") VNĐ
        </dd>

        <!-- Ngày xuất bản -->
        <dt class="col-sm-3">
            Ngày xuất bản
        </dt>

        <dd class="col-sm-9">
            @Model.PublishedDate.ToString("dd/MM/yyyy")
        </dd>

        <!-- Ảnh sách -->
        <dt class="col-sm-3">
            Ảnh sách
        </dt>

        <dd class="col-sm-9">

            @if (!string.IsNullOrEmpty(Model.ImageFileName))
            {
                <img src="~/images/books/@Model.ImageFileName"
                     alt="@Model.Title"
                     style="width:200px;
                height:260px;
                object-fit:cover;
                border-radius:8px;" />
            }
            else
            {
                <span class="text-muted">
                    Chưa có ảnh
                </span>
            }

        </dd>

    </dl>

    <!-- Nút sửa -->
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Sửa
    </a>

    <!-- Nút quay lại -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</div>
